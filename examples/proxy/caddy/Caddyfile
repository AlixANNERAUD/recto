# Caddy in front of recto. Caddy gets and renews the certificate by itself.
# Replace recto.example.org. With recto in Compose, use recto:8080; on the same host,
# 127.0.0.1:8080.

recto.example.org {
	# No upload limit is set by default; this one is a little above RECTO_MAX_UPLOAD_SIZE
	# (50 MiB by default), which recto accepts with 64 KiB of form fields on top.
	request_body {
		max_size 51MiB
	}

	reverse_proxy recto:8080 {
		# Caddy keeps Host, sets X-Forwarded-Proto and replaces X-Forwarded-For (it only
		# appends when trusted_proxies is set), as RECTO_TRUST_FORWARDED_HEADERS needs. It
		# sets no response timeout, so long scans finish.
		# Send data to the browser as it comes rather than in steps.
		flush_interval -1
	}
}
